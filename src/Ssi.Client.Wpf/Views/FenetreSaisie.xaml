<Window x:Class="Ssi.Client.Wpf.Views.FenetreSaisie"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="Question" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBox x:Name="Reponse" AcceptsReturn="True" Height="70" TextWrapping="Wrap" Margin="0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Valider" IsDefault="True" Click="Valider_Click" Style="{StaticResource Principal}"/>
            <Button Content="Annuler" IsCancel="True" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
