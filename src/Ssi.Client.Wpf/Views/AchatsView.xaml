<UserControl x:Class="Ssi.Client.Wpf.Views.AchatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Saisie d'une commande ou d'une réception -->
        <Border Style="{StaticResource Carte}" IsEnabled="{Binding PeutCreer}">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Fournisseur" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{Binding Fournisseurs}" SelectedItem="{Binding Fournisseur}" DisplayMemberPath="Nom" MinWidth="180" Margin="0,0,8,4"/>
                    <TextBlock Text="Produit" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{Binding Produits}" SelectedItem="{Binding Produit}" DisplayMemberPath="Designation" MinWidth="170" Margin="0,0,8,4"/>
                    <TextBlock Text="Cuve" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{Binding CuvesDuProduit}" SelectedItem="{Binding Cuve}" DisplayMemberPath="Code" MinWidth="90" Margin="0,0,8,4"/>
                    <TextBlock Text="Quantité" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{Binding Quantite, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,8,4"/>
                    <TextBlock Text="Prix HT" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{Binding Prix, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,8,4"/>
                    <Button Content="Ajouter la ligne" Command="{Binding AjouterLigneCommand}"/>
                    <Button Content="Vider" Command="{Binding ViderLignesCommand}"/>
                </WrapPanel>
                <DataGrid ItemsSource="{Binding Lignes}" IsReadOnly="False" MaxHeight="170" Margin="0,6,0,6">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Produit" Binding="{Binding Produit.Designation}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="Emplacement" Binding="{Binding Emplacement, Mode=OneWay}" IsReadOnly="True" Width="90"/>
                        <DataGridTextColumn Header="Commandé" Binding="{Binding QuantiteCommandee, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        <DataGridTextColumn Header="Chargé (BL)" Binding="{Binding QuantiteChargee, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        <DataGridTextColumn Header="Reçu" Binding="{Binding QuantiteRecue, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        <DataGridTextColumn Header="Accepté" Binding="{Binding QuantiteAcceptee, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        <DataGridTextColumn Header="Prix HT" Binding="{Binding PrixUnitaireHt, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                        <DataGridTextColumn Header="Justification d'écart" Binding="{Binding Justification, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>
                <WrapPanel>
                    <TextBlock Text="Réf. fournisseur" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{Binding ReferenceFournisseur}" Width="110"/>
                    <Button Content="Créer la commande" Command="{Binding CreerCommandeCommand}"/>
                    <Border BorderBrush="{StaticResource Bordure}" BorderThickness="1,0,0,0" Margin="8,0" Padding="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="BL" Style="{StaticResource Etiquette}"/>
                            <TextBox Text="{Binding NumeroBl}" Width="100"/>
                            <TextBlock Text="Transporteur" Style="{StaticResource Etiquette}"/>
                            <TextBox Text="{Binding Transporteur}" Width="110"/>
                            <TextBlock Text="Véhicule" Style="{StaticResource Etiquette}"/>
                            <TextBox Text="{Binding Vehicule}" Width="90"/>
                            <Button Content="Enregistrer la réception" Style="{StaticResource Principal}" Command="{Binding EnregistrerReceptionCommand}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
                <TextBlock Text="Réception rattachée à la commande sélectionnée" Foreground="{StaticResource Primaire}" Margin="0,4,0,0"
                           Visibility="{Binding ModeReception, Converter={StaticResource Visible}}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,12,0">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Commandes" Style="{StaticResource SousTitre}" Margin="0,0,12,0"/>
                    <Button Content="Confirmer" Command="{Binding ConfirmerCommandeCommand}" IsEnabled="{Binding PeutValider}"/>
                    <Button Content="Réceptionner" Command="{Binding PreparerReceptionCommand}" IsEnabled="{Binding PeutCreer}"/>
                    <Button Content="Annuler…" Command="{Binding AnnulerCommandeCommand}" IsEnabled="{Binding PeutAnnuler}"/>
                </WrapPanel>
                <DataGrid DockPanel.Dock="Bottom" ItemsSource="{Binding Commande.Lignes}" MaxHeight="130" Margin="0,6,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Produit" Binding="{Binding Produit}" Width="*"/>
                        <DataGridTextColumn Header="Commandé" Binding="{Binding Quantite, StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn Header="Reçu" Binding="{Binding QuantiteRecue, StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn Header="Prix HT" Binding="{Binding PrixUnitaireHt, StringFormat=N4}" Width="85"/>
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid ItemsSource="{Binding Commandes}" SelectedItem="{Binding Commande}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N°" Binding="{Binding Numero}" Width="120"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yy}" Width="75"/>
                        <DataGridTextColumn Header="Fournisseur" Binding="{Binding Fournisseur}" Width="*"/>
                        <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="80"/>
                        <DataGridTextColumn Header="Total HT" Binding="{Binding TotalHt, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <DockPanel Grid.Column="1">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Réceptions" Style="{StaticResource SousTitre}" Margin="0,0,12,0"/>
                    <Button Content="Valider" Style="{StaticResource Principal}" Command="{Binding ValiderReceptionCommand}" IsEnabled="{Binding PeutValider}"/>
                    <Button Content="Annuler…" Command="{Binding AnnulerReceptionCommand}" IsEnabled="{Binding PeutAnnuler}"/>
                </WrapPanel>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Carte}" Margin="0,6,0,0" Visibility="{Binding PeutFacturer, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock Text="Facture fournisseur de la réception sélectionnée (quantités et prix de la facture papier)" FontWeight="SemiBold"/>
                        <DataGrid ItemsSource="{Binding LignesFacture}" IsReadOnly="False" MaxHeight="120" Margin="0,4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produit" Binding="{Binding Produit.Designation}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="Quantité facturée" Binding="{Binding QuantiteAcceptee, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                <DataGridTextColumn Header="Prix HT facturé" Binding="{Binding PrixUnitaireHt, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel>
                            <TextBlock Text="N° facture fournisseur" Style="{StaticResource Etiquette}"/>
                            <TextBox Text="{Binding NumeroFacture, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DatePicker SelectedDate="{Binding DateFacture}"/>
                            <Button Content="Enregistrer la facture" Command="{Binding SaisirFactureCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <DataGrid ItemsSource="{Binding Receptions}" SelectedItem="{Binding Reception}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N°" Binding="{Binding Numero}" Width="120"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding Horodatage, StringFormat=dd/MM/yy HH:mm}" Width="100"/>
                        <DataGridTextColumn Header="Fournisseur" Binding="{Binding Fournisseur}" Width="*"/>
                        <DataGridTextColumn Header="BL" Binding="{Binding NumeroBl}" Width="90"/>
                        <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
