<UserControl x:Class="Ssi.Client.Wpf.Views.VentesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,12,0" IsEnabled="{Binding PeutCreer}">
            <TextBlock DockPanel.Dock="Top" Text="Nouvelle vente" Style="{StaticResource SousTitre}" Margin="0,0,0,6"/>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <ComboBox ItemsSource="{Binding Articles}" SelectedItem="{Binding Article}" DisplayMemberPath="Designation" MinWidth="220" IsEditable="True" IsTextSearchEnabled="True"/>
                <TextBlock Text="Qté" Style="{StaticResource Etiquette}"/>
                <TextBox Text="{Binding Quantite, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                <TextBlock Text="Prix TTC" Style="{StaticResource Etiquette}"/>
                <TextBox Text="{Binding Prix, UpdateSourceTrigger=PropertyChanged}" Width="80" IsEnabled="{Binding PeutModifierPrix}"/>
                <Button Content="Ajouter" Command="{Binding AjouterCommand}" IsDefault="True"/>
            </WrapPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="Encaisser" Style="{StaticResource Principal}" Command="{Binding EncaisserCommand}" Margin="0"/>
                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" MinWidth="110"/>
                <ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding Client}" DisplayMemberPath="Nom" MinWidth="180"
                          Visibility="{Binding EstCredit, Converter={StaticResource Visible}}"/>
                <TextBlock Text="{Binding TotalPanier, StringFormat=Total {0:N2} DH TTC}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0"/>
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Button Content="Retirer la ligne" Command="{Binding RetirerCommand}" HorizontalAlignment="Left"/>
            </DockPanel>
            <DataGrid ItemsSource="{Binding Panier}" SelectedItem="{Binding LignePanier}" MinHeight="140" DockPanel.Dock="Top" MaxHeight="260">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Article" Binding="{Binding Produit.Designation}" Width="*"/>
                    <DataGridTextColumn Header="Qté" Binding="{Binding Quantite, StringFormat=N2}" Width="60"/>
                    <DataGridTextColumn Header="Prix TTC" Binding="{Binding PrixUnitaireTtc, StringFormat=N2}" Width="80"/>
                    <DataGridTextColumn Header="Montant" Binding="{Binding MontantTtc, StringFormat=N2}" Width="90"/>
                    <DataGridCheckBoxColumn Header="Prix modifié" Binding="{Binding PrixModifie}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel>
                <TextBlock Text="Stock des articles" Style="{StaticResource SousTitre}"/>
                <DataGrid ItemsSource="{Binding Positions}" MaxHeight="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Article" Binding="{Binding Designation}" Width="*"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding Quantite, StringFormat=N2}" Width="70"/>
                        <DataGridTextColumn Header="Unité" Binding="{Binding Unite}" Width="55"/>
                        <DataGridCheckBoxColumn Header="Sous seuil" Binding="{Binding SousSeuil}" Width="75"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Column="1">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="Ventes depuis le" Style="{StaticResource Etiquette}"/>
                <DatePicker SelectedDate="{Binding Du}"/>
                <Button Content="Rechercher" Command="{Binding RechercherCommand}"/>
                <Button Content="Annuler la vente…" Command="{Binding AnnulerCommand}" Visibility="{Binding PeutAnnuler, Converter={StaticResource Visible}}"/>
            </WrapPanel>
            <DataGrid DockPanel.Dock="Bottom" ItemsSource="{Binding VenteSelectionnee.Lignes}" MaxHeight="200" Margin="0,8,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Article" Binding="{Binding Produit}" Width="*"/>
                    <DataGridTextColumn Header="Qté" Binding="{Binding Quantite, StringFormat=N2}" Width="60"/>
                    <DataGridTextColumn Header="Prix TTC" Binding="{Binding PrixUnitaireTtc, StringFormat=N2}" Width="80"/>
                    <DataGridTextColumn Header="TVA" Binding="{Binding TauxTva, StringFormat=P0}" Width="50"/>
                    <DataGridTextColumn Header="TTC" Binding="{Binding MontantTtc, StringFormat=N2}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
            <DataGrid ItemsSource="{Binding Ventes}" SelectedItem="{Binding VenteSelectionnee}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N°" Binding="{Binding Numero}" Width="120"/>
                    <DataGridTextColumn Header="Heure" Binding="{Binding Horodatage, StringFormat=dd/MM HH:mm}" Width="85"/>
                    <DataGridTextColumn Header="Mode" Binding="{Binding ModeReglement}" Width="80"/>
                    <DataGridTextColumn Header="Client" Binding="{Binding Client}" Width="*"/>
                    <DataGridTextColumn Header="TTC" Binding="{Binding TotalTtc, StringFormat=N2}" Width="90"/>
                    <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
