<Application x:Class="Ssi.Client.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Ssi.Client.Wpf.ViewModels"
             xmlns:v="clr-namespace:Ssi.Client.Wpf.Views"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="Primaire" Color="#0B5C8E"/>
            <SolidColorBrush x:Key="PrimaireClair" Color="#E6F0F7"/>
            <SolidColorBrush x:Key="Danger" Color="#B42318"/>
            <SolidColorBrush x:Key="DangerClair" Color="#FDECEA"/>
            <SolidColorBrush x:Key="Succes" Color="#1E7B34"/>
            <SolidColorBrush x:Key="SuccesClair" Color="#E8F5EC"/>
            <SolidColorBrush x:Key="Attention" Color="#9A6700"/>
            <SolidColorBrush x:Key="Bordure" Color="#D0D7DE"/>
            <BooleanToVisibilityConverter x:Key="Visible"/>
            <v:InverseVisibilite x:Key="Invisible"/>
            <v:NonVideVisibilite x:Key="SiTexte"/>
            <v:Negation x:Key="Non"/>
            <v:LibelleEnum x:Key="Libelle"/>
            <!-- Toute valeur d'énumération affichée dans une liste déroulante ou un contenu : libellé français -->
            <DataTemplate DataType="{x:Type sys:Enum}"><TextBlock Text="{Binding Converter={StaticResource Libelle}}"/></DataTemplate>

            <Style TargetType="Button">
                <Setter Property="Padding" Value="12,5"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="MinWidth" Value="90"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style x:Key="Principal" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource Primaire}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="4,3"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="MinWidth" Value="90"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="MinWidth" Value="140"/>
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
            <Style x:Key="Titre" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
            <Style x:Key="SousTitre" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,12,0,6"/>
            </Style>
            <Style x:Key="Etiquette" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Foreground" Value="#57606A"/>
            </Style>
            <Style TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#EAEEF2"/>
                <Setter Property="RowHeight" Value="26"/>
                <Setter Property="BorderBrush" Value="{StaticResource Bordure}"/>
                <Setter Property="SelectionMode" Value="Single"/>
            </Style>
            <Style x:Key="Nombre" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>
            <Style x:Key="Carte" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource Bordure}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,0,10,10"/>
            </Style>

            <DataTemplate DataType="{x:Type vm:TableauBordViewModel}"><v:TableauBordView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SaisieJourneeViewModel}"><v:SaisieJourneeView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PostesViewModel}"><v:PostesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CaisseViewModel}"><v:CaisseView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:VentesViewModel}"><v:VentesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:StocksViewModel}"><v:StocksView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:VracViewModel}"><v:VracView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:TiersViewModel}"><v:TiersView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:FacturesViewModel}"><v:FacturesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:TresorerieViewModel}"><v:TresorerieView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RentabiliteViewModel}"><v:RentabiliteView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RapportsViewModel}"><v:RapportsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AdministrationViewModel}"><v:AdministrationView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AchatsViewModel}"><v:AchatsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ParametrageViewModel}"><v:ParametrageView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PersonnelViewModel}"><v:PersonnelView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
